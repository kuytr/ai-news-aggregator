# ============================================================
# AI News Aggregator - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Application
APP_SECRET_KEY=your-super-secret-key-change-this-in-production
APP_DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=8000

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./news_aggregator.db

# NewsAPI (https://newsapi.org/)
NEWS_API_KEY=your_newsapi_key_here

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=AI News Aggregator
SMTP_FROM_EMAIL=your_email@gmail.com

# OTP Configuration
OTP_EXPIRE_MINUTES=10

# Scheduler
NEWS_FETCH_INTERVAL_MINUTES=30
DAILY_DIGEST_HOUR=8
DAILY_DIGEST_MINUTE=0

# Frontend
ARTICLES_PER_PAGE=12
