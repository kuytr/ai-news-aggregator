# ============================================================
# AI News Aggregator - Environment Variables Sample
# Copy this to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME="AI News Aggregator"
APP_SECRET_KEY="your-super-secret-key-change-this-in-production"
DEBUG=True

# --- Database ---
DATABASE_URL="sqlite:///./news_aggregator.db"

# --- JWT ---
JWT_SECRET_KEY="your-jwt-secret-key-change-this"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OpenAI ---
OPENAI_API_KEY="sk-your-openai-api-key"

# --- NewsAPI ---
NEWSAPI_KEY="your-newsapi-key-from-newsapi.org"

# --- Email (SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="AI News Aggregator"

# --- OTP ---
OTP_EXPIRE_MINUTES=10

# --- RSS Feeds (comma-separated) ---
RSS_FEEDS="https://feeds.bbci.co.uk/news/technology/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/Technology.xml,https://feeds.feedburner.com/TechCrunch,https://www.theverge.com/rss/index.xml"

# --- Scheduler ---
NEWS_FETCH_INTERVAL_MINUTES=30
DAILY_EMAIL_HOUR=8
DAILY_EMAIL_MINUTE=0
